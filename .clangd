CompileFlags:
  CompilationDatabase: build
  Add:
    - -I${workspaceFolder}
    - -I/usr/local/cuda/include
    - -I/usr/local/cuda/include/cccl

If:
  PathMatch: '.*\.(cu|cuh)$'
  CompileFlags:
    Add:
      - -xcuda
      - --cuda-path=/usr/local/cuda
      - --cuda-gpu-arch=sm_86

Diagnostics:
  MissingIncludes: true

ClangTidy:
  Add:
    - bugprone-*
    - performance-*
